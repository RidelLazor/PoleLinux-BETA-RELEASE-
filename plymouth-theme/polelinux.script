/* PoleLinux Plymouth Boot Splash */

FRAMES       = 12;
FRAME_DELAY  = 0.080;
BAR_W        = 320;
BAR_H        = 16;

/* Load spinner frames */
for (i = 0; i < FRAMES; i++) {
    spinner[i] = Image(sprintf("spinner-%04d.png", i));
}

/* Create sprites from images */
for (i = 0; i < FRAMES; i++) {
    spinner[i].sprite = Sprite(spinner[i]);
}

/* Full-screen background sprite */
bg_img  = Image("background.png");
bg_spr  = Sprite(bg_img);

/* Progress bar sprites */
track_spr = Sprite(Image("throbber-bg.png"));
fg_sprite  = Sprite();
fg_orig    = Image("throbber-fg.png");

/* Layout */
screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

spinner_w = 220;
spinner_h = 220;
spinner_x = (screen_w - spinner_w) / 2;
spinner_y = (screen_h - spinner_h) / 2 - 40;

bar_x = (screen_w - BAR_W) / 2;
bar_y = spinner_y + spinner_h + 30;

/* Position sprites */
bg_spr.SetPosition(0, 0, 0);

for (i = 0; i < FRAMES; i++) {
    spinner[i].sprite.SetPosition(spinner_x, spinner_y, 1);
    spinner[i].sprite.SetVisible(false);
}

track_spr.SetPosition(bar_x, bar_y, 0);
fg_sprite.SetPosition(bar_x, bar_y, 2);

/* Show first frame */
current_frame = 0;
spinner[0].sprite.SetVisible(true);

last_tick = Plymouth.GetTime();

/* Always set background so it persists across frames */
Window.SetBackgroundTopColor(0.039, 0.039, 0.071);
Window.SetBackgroundBottomColor(0.039, 0.039, 0.071);

fun refresh_callback ()
{
    /* Animate spinner */
    now = Plymouth.GetTime();
    if (now - last_tick >= FRAME_DELAY) {
        next = (current_frame + 1) % FRAMES;
        spinner[current_frame].sprite.SetVisible(false);
        spinner[next].sprite.SetVisible(true);
        current_frame = next;
        last_tick = now;
    }

    /* Progress bar */
    progress = Plymouth.GetProgress();
    clip = Math.Int(BAR_W * progress);
    if (clip < 0)  clip = 0;
    if (clip > BAR_W) clip = BAR_W;
    fg_sprite.SetImage(fg_orig.Scale(clip, BAR_H));
}

Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback ()
{
    for (i = 0; i < FRAMES; i++) {
        spinner[i].sprite.SetVisible(false);
    }
}

Plymouth.SetQuitFunction(quit_callback);
